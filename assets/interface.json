    "interface_version": 2,
    "name": "AutoButter",
    "description": "安卓平台小游戏资源自动获取。",
    "license": "MIT",
    "welcome": "首次使用！请先在设置中选择设备，然后确认截图正常后再运行任务。",
    "version": "0.1.0",
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            // 模板素材统一按 720 短边画布裁切，不要随意改动
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "默认",
            "path": [
                "./resource"
            ]
        }
    ],
    // 需要自定义识别/动作时再解开注释，并在 agent/ 下实现
    // "agent": {
    //     "child_exec": "python",
    //     "child_args": [
    //         "./agent/main.py"
    //     ]
    // },
    "task": [
        {
            "name": "环境自检：截图存盘",
            "entry": "SelfCheck"
        },
        {
            "name": "环境自检：点击屏幕中心",
            "entry": "TapCenter"
        }
    ]
}
