    "加号闸门": {
        "recognition": "Custom",
        "custom_recognition": "PlusGate",
        "custom_recognition_param": {"max_plus": 4},
        "action": "DoNothing",
        "timeout": 1000,
        "next": ["加一只鸡妖"]
