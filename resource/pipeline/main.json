    "等待冷却": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "WaitCooldown",
        "timeout": 6000,
        "next": ["回主界面"]
    },
    // ===== 刷新探寻列表（需求方 11-15）=====
    //
    // 前提：列表已经滑到底（`滑不动了`）且还有空闲鸡妖。
    // 游戏只重刷**最上面 3 个**秘境，所以刷完要重新从列表顶部看一遍。
    //
    // 整条链路：
    //   刷新闸门（按钮橙色 + 配额未满 + stock>0）
    //     → 点刷新 → 关列表 → 重进列表（点探尋，从顶部开始）
    //       → 主循环选行
    //   刷新闸门不命中（按钮灰 / 没配额 / 没鸡妖）
    //     → 循环闸门 → 回主页面重进秘境
    "刷新闸门": {
        "recognition": "Custom",
        "custom_recognition": "RefreshGate",
        "custom_recognition_param": {"max_refresh": 3},
        "action": "DoNothing",
        "timeout": 1500,
        "next": ["点刷新"],
        // 闸门作为候选被执行时，它自己的 on_error 不生效（§3.21）；
        // 这里写它是为了单跑 `刷新闸门` 调试时有落点。
        "on_error": ["循环闸门"]
    },
    "点刷新": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "ClickRefresh",
        "timeout": 3000,
        "next": ["关列表"],
        // 点不到（按钮在截图前变灰了）→ 当作不可点，去重进
        "on_error": ["循环闸门"]
    },
    // 刷新只重刷最上面 3 个秘境；当前滚动位置看不到它们，
    // 所以关掉列表再点「探尋」重新从顶部进（比滑回顶部快，需求方确认）。
    "关列表": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "CloseList",
        "timeout": 4000,
        "next": ["主循环探尋"],
        "on_error": ["循环闸门"]
    },
    // 命中 = 还可以再回主界面重来一次；不命中 = 到上限，落到 `列表已到底`。
    "循环闸门": {
        "recognition": "Custom",
        "custom_recognition": "LoopGuard",
        "custom_recognition_param": {"max_loops": 5},
        "action": "DoNothing",
        "timeout": 1000,
        // 先清弹窗，再点「冒险」回主页面
        "next": ["退到主页面"],
        // 回主界面失败（按钮点不到 / 界面变了）→ 收尾，别硬撑
        "on_error": ["异常收尾"]
    },
    // 底部「冒险」是主页面 tab；「家園」只是打开家园子菜单，不能用来回主页面。
    // nav_adventure.png 在 720_realm_panel / 21_main_720 / 720_list_top
    // 上都命中 0.988~1.000 @(607,1427)。
    "回主界面": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "ClickAdventure",
        "timeout": 2000,
        // 需求方 11-14：回主页面**只点右上角蓝点**（exit_anchor），
        // 不再点底栏「冒险」tab。原因两条：
        //   1. tab 在秘境面板上也能匹配，点它只切 tab、不关面板；
        //   2. 原生 Click 在 100x100 的 tab 框里随机取点，18~25% 落在
        //      图标外（§3.45）。
        // 用 DirectHit：当前是否已在主页面由 ClickAdventure 自己判
        // （既不是秘境面板、也没有探寻列表行 → 直接返回，不点）。
        "next": ["重进-找菜单"],
        // 菜单收着（`重进-找菜单` 失败）→ 先过 `重进开菜单闸门` 再点「家園」。
        //
        // 为什么闸门要放在这里（§3.53）：原来直接写 `重进-开菜单`，靠它的
        // `max_hit: 3` 当刹车 —— 但那是**整趟任务共享**的配额，长任务重进
        // 4 次就用光，之后家園再也点不开、任务无声收尾（11-15 15:25 那轮
        // 583s 的 `重进失败` 正是这个）。改成 `ReopenGate` 的**每轮配额**：
        // `ClickAdventure` 每成功回一次主页面就清零。
        "on_error": ["重进开菜单闸门", "重进失败"]
    },
    // 命中 = 本轮重进还可以再点一次「家園」展开菜单（每轮 3 次，§3.53）
    "重进开菜单闸门": {
        "recognition": "Custom",
        "custom_recognition": "ReopenGate",
        "custom_recognition_param": {"max_reopen": 3},
        "action": "DoNothing",
        "timeout": 1000,
        "next": ["计数并开菜单"]
    },
    "计数并开菜单": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "CountReopen",
        "timeout": 1000,
        "next": ["重进-开菜单"]
    },
    // 子菜单里的「淫乱秘境」项（§3.5：菜单展开时才能点到）
    "重进-找菜单": {
        "recognition": "TemplateMatch",
        "template": "home_menu_first.png",
        "roi": [0, 600, 400, 1000],
        "threshold": 0.8,
        "action": "Click",
        "timeout": 3000,
        "post_wait_freezes": 600,
        // 菜单没展开时**不写自己的 on_error**：让 `回主界面` 判失败，
        // 由它的 on_error 去 `重进-开菜单` 点「家園」把菜单展开（§3.21）
        // 重进秘境同样可能先弹「恭喜獲得」，先清弹窗再确认。
        "next": ["清弹窗后继续", "重进-确认"]
    },
    // 菜单收着：再点一次「家園」把它展开，然后回到找菜单
    "重进-开菜单": {
        "recognition": "TemplateMatch",
        "template": "nav_home.png",
        "roi": [0, 600, 720, 1200],
        "threshold": 0.8,
        "action": "Click",
        // 同 `打开家园菜单`：把随机落点收进图标中心。
        "target_offset": [30, 30, -50, -50],
        // 同上：不写 timeout 会用默认 20000。11-14 实机 198.4s→219.3s
        // 那 20.9s 就是这么来的（§3.44）。
        "timeout": 4000,
        "post_wait_freezes": 1000,
        // 同上：max_hit 只对「自己出现在 next 里」生效。11-14 实机
        // 113.8s 点了一次「家園」没打开菜单，就直接 重进失败 → 列表已到底
        // 收尾了（§3.45）。把 `重进-开菜单` 自己放进 next 才会重试。
        //
        // 11-15 去掉 `max_hit`（§3.53）：它是**整个任务共享**的全局配额，
        // 不是「每轮重进重置」。11-15 15:25 那轮一共重进了 4 次
        // （222 / 456 / 549 / 583s），第 4 次时配额已用光 → 节点被静默跳过
        // → `回主界面.on_error` 只剩 `重进失败` → 直接落 `列表已到底` 判失败。
        //
        // 刹车改由 `重进开菜单闸门`（ReopenGate）负责：**每轮重进** 3 次，
        // `ClickAdventure` 成功回主页面即清零。
        //
        // **不再自引用**（原 `next: [..., 重进-开菜单]`）：自引用 + 无 max_hit
        // = 死循环（11-15 实测：`重进-开菜单` 连续命中 20+ 次停不下来）。
        // 重试改由 on_error 走闸门，闸门用光才落 `重进失败`。
        "next": ["重进-找菜单"],
        "on_error": ["重进开菜单闸门", "重进失败"]
    },
    // 重进后的落地校验：秘境面板的「管理」按钮
    "重进-确认": {
        "recognition": "TemplateMatch",
        "template": "realm_marker.png",
        "roi": [0, 400, 720, 1100],
        "threshold": 0.9,
        "action": "Custom",
        "custom_action": "SetRealm",
        "custom_action_param": {"realm": "own"},
        "timeout": 5000,
        // 重开后先读鸡妖：有就直接继续；0 才等一次「恭喜獲得」弹窗。
        // 旧路径 `等待回补` 会先等弹窗，容易在弹窗已被清掉时白等 120s。
        "next": ["读空闲鸡妖", "等待获得弹窗"],
        "on_error": ["重进失败"]
    },
    // 旧路径备用：只有 MarkWait 设置 need_wait 时才进入等待。
    // 当前 `重进-确认` 已改为先读鸡妖，0 时直接走 `等待获得弹窗`。
    "等待回补": {
        "recognition": "Custom",
        "custom_recognition": "WaitReturnGate",
        "action": "DoNothing",
        "timeout": 1000,
        "next": ["等待获得弹窗"]
    },
    // 等「恭喜獲得」事件；CLI 看弹窗护栏计数，GUI 匹配 obtain_resource.png
    "等待获得弹窗": {
        "recognition": "DirectHit",
        "roi": [0, 0, 720, 1560],
        "action": "Custom",
        "custom_action": "WaitPopup",
        // 30s（原 120s）：库存 0 且没有派兵在途时，等两分钟也不会出现
        // 「恭喜獲得」，只会让 GUI 看起来卡死（§3.66）。超时后
        // on_error 回到落地校验重新读库存。
        "custom_action_param": {"timeout": 30, "interval": 2.0},
        // 这个 timeout 只管「等到弹窗后扫 `清弹窗后继续` 的窗口」，
        // 不会截断 WaitPopup 自己的 30s（Custom Action 不受 timeout 限制，
        // 11-14 实测，§3.44）。不写就是默认 20000。
        "timeout": 3000,
        "next": ["清弹窗后继续"],
        // 超时/弹窗事件错过时也不要卡死：回落地校验后重读鸡妖。
        "on_error": ["确认已进入秘境"]
    },
    // 主循环里的选格。识别逻辑与 `选格并点击` 完全相同（同一个 PickCell），
    // 只是失败后的落点不同：这里转去「探尋」，不是收尾。
    "主循环选格": {
        "recognition": "Custom",
        "custom_recognition": "PickCell",
        "roi": [0, 250, 720, 810],
        "action": "Click",
        "timeout": 2500,
        "post_wait_freezes": 600,
        "next": ["确认资源详情"],
        // §3.52：别人秘境里没格子时**直接标记 + 退出**，不再绕
        // `主循环无目标` → `他人无目标分支` 两步（那两步只是把 realm
        // 再判一次，白花 ~2.6s）。自家秘境仍然走 `主循环无目标` 去探尋。
        //
        // 顺序不能反：`他人空秘境退出` 是 Custom 识别（看 realm），
        // 在自家秘境里恒不命中，会自动落到第二候选 `主循环无目标`。
        "on_error": ["他人空秘境退出", "主循环无目标"]
    },
    // 别人秘境里没有可抢的格子 → 标记这一行 + 退出回列表（§3.52）
    "他人空秘境退出": {
        "recognition": "Custom",
        "custom_recognition": "RealmOtherGate",
        "action": "Custom",
        "custom_action": "MarkBadRow",
        "timeout": 1500,
        // 同 `标记已访问`：回列表就是点「探尋」（§3.54）
        "next": ["点探尋并下翻"]
    },
    // 自己秘境里没有需要的资源：点「探尋」进列表（§5 的 (@0) 无资源分支）
    "主循环无目标": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        // §3.52 修正：判断必须写在这里，不能写在 `主循环选格.on_error`。
        //
        // 主链是 `读空闲鸡妖.next = ["主循环选格", "主循环无目标"]`，
        // `主循环选格` 是**候选节点** —— 候选失败时 Maa 会忽略它自己的
        // `on_error`，直接回落调用方的下一个候选（§3.21）。所以
        // `主循环选格.on_error = ["他人空秘境退出", ...]` 在主链上
        // **一次都不会执行**（11-15 17:07 实机 trace 证实：PickCell 没目标后
        // 直接进了 `主循环无目标`，`他人空秘境退出` 全程未出现）。
        //
        // 现在把判断放到调用方的 next 第一位：
        //   - 别人秘境 → `他人空秘境退出`（MarkBadRow）→ `退出他人秘境`，两步搞定
        //   - 自家秘境 → `RealmOtherGate` 不命中 → 回落 `主循环探尋`
        "next": ["他人空秘境退出", "主循环探尋"],
        "timeout": 2000
    },
    // 备用节点：主链已改走 `主循环无目标.next` 的 `他人空秘境退出`（§3.52），
    // 本节点保留给旧的调试入口 / 手工验证，不再出现在主链上。
    "他人无目标分支": {
        "recognition": "Custom",
        "custom_recognition": "RealmOtherGate",
        "action": "DoNothing",
        "timeout": 1000,
        "next": ["标记空秘境"]
    },
    // 回主界面 / 重进秘境失败：**不再直接收尾**。
    // 需求方 11-14：某一轮因为网络问题没退出到主菜单，任务就直接结束了。
    // 现在先过 `重进失败重试门`：每轮点一次蓝点 + 等 3s，最多 8 轮（约 25s），
    // 真正处理不了才落 `列表已到底` 收尾。
    "重进失败": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        // 候选是 `重进失败重试门`（可能连续失败 8 轮），不写 timeout 会用
        // 默认 20000 一次性卡满，反而把「每轮点蓝点」拖成 20s。
        "timeout": 1500,
        "next": ["重进失败重试门"]
    },
    // 重进秘境失败后的重试门：RecoverNet 内部自己循环
    // （每轮截图判界面 → 点蓝点 → 等 3s），最多 max_rounds 轮。
    //
    // **它不检测网络**。触发条件只有「重进链路失败」：`打开家园菜单` /
    // `退到主页面` / `重进-开菜单` / `重进-确认` 任一失败。真断线时
    // 蓝点也点不动，这个门帮不上忙；它能处理的是「界面卡住但游戏还活着」。
    // （节点名 11-15 改过两次：`网络恢复门` → `重进重试门` → `重进失败重试门`。
    //  第一次是为了去掉「网络」二字，别再让人以为它有网络检测能力；
    //  第二次是需求方指定，让名字直接表明它接的是 `重进失败` 这条边。）
    //
    // **不读文字**（需求方 11-14 19:13：不要校验，任何异常都返回主页面）；
    // **不用 BACK**：这个游戏不响应系统返回键。
    // 一旦回到冒险主页面就放行，接着走 `重进-找菜单`。
    //
    // 11-14 修正：这里原来是 `"recognition": "Custom"` +
    // `"custom_recognition": "RecoverNet"`，但 RecoverNet 是 CustomAction，
    // Maa 报 `recognition is null`，节点每次直接失败 —— 恢复门从未执行过。
    // 改成 DirectHit + Custom action，轮次由动作自己数，不再靠 `max_hit`
    // 和 next 里的自引用。
    "重进失败重试门": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "RecoverNet",
        "custom_action_param": {"max_rounds": 8},
        // timeout 只管「识别 + 扫 next 候选」的窗口，不截断动作内部耗时
        // （§3.44 已实测），所以 8 轮 × 3s 不会被它打断。
        "timeout": 2000,
        "next": ["重进-找菜单"],
        "on_error": ["异常收尾"]
    },
    // ===== 收尾节点（§3.50）=====
    //
    // 需求方 11-15：`列表已到底` 要**判失败**（任务红色结束），不能再静默绿着收。
    //
    // 但并不是所有收尾都是异常：
    //   - `列表已到底`  = 循环预算用完 / 刷新不可点 / 重进也回不来 → 真的没得干 → 红
    //   - `选行结束`    = `选行并点击` 调试入口「这一页没有目标行」 → 正常 → 绿
    //   - `探尋失败`    = `点探尋` 调试入口点不进列表 → 异常 → 红
    //
    // 三个都用 `AbortTask` / `DoNothing` 区分，不靠「模板必不中」那种
    // 会白等 20s timeout 的写法。
    "异常收尾": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "AbortTask",
        "custom_action_param": {
            "reason": "列表翻到底且刷新不可点，重进也没产出，任务提前结束"
        },
        "timeout": 1000,
        // 失败时弹提示（MFAAvalonia 负责显示）
        "focus": {
            "Node.PipelineNode.Failed": {
                "content": "异常收尾：刷新不可点且重进无产出，请手动检查游戏状态后重跑",
                "display": ["log", "toast"]
            }
        }
    },
    // `选行并点击` 调试入口的正常终点（绿）
    "选行结束": {
        "recognition": "DirectHit",
        "action": "DoNothing"
    },
    // `点探尋` 调试入口点不进列表（红）
    "探尋失败": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "AbortTask",
        "custom_action_param": {
            "reason": "点探尋后没有进入探寻列表"
        },
        "timeout": 1000,
        "focus": {
            "Node.PipelineNode.Failed": {
                "content": "点探尋失败：点击后没有进入探寻列表，请手动确认游戏状态",
                "display": ["log", "toast"]
            }
        }
    }
}
