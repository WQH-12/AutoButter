{
    // ===== 主任务入口 =====
    // 先「接线」再跑：把调试入口的终点改写成主循环的落点（只影响本次任务）。
    // 这样同一个节点既能单跑调试、又能进主链，不用维护两份。
    "主任务": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "RewireMain",
        "custom_action_param": {
            // 自己秘境：读空闲鸡妖 → 选格 → 派遣 → 掠奪 → 回面板再读
            "确认已进入秘境": ["读空闲鸡妖", "没有空闲鸡妖"],
            "确认资源详情": ["派遣并掠奪"],
            "掠奪": ["掠夺后分支", "清弹窗后继续", "读空闲鸡妖", "没有空闲鸡妖"],
            // 自己秘境没资源 → 探尋 → 列表
            "没有目标资源": ["主循环探尋"],
            // 别人秘境没资源 → 标记这个空秘境 → 探尋并下翻 → 列表
            "他人秘境无目标": ["标记空秘境"],
            // `列表已到底` 是「滑动预算用完 / 刷新不可点 / 重进无产出」的终点，
            // 从这里再点「探尋」没有意义（可能已经不在列表页了）。
            // 「回到列表继续找」由 `滑不动了` → `循环闸门` → `回主界面` 负责。
            // 11-15：它现在**判失败**（AbortTask），不再静默绿着收（§3.50）。
            // 11-14：重进秘境失败时不再直接收尾，先过 `重进失败重试门`
            // （每轮点蓝点 + 等待，最多 8 轮）再决定。
            "重进失败": ["重进失败重试门"]
        },
        "next": ["进入淫乱秘境"]
    },
    // ===== 任务一：主界面 -> 家园 -> 淫乱秘境 =====
    // 全部基于模板匹配，不写死点击坐标；点击位置由识别结果决定。
    // 「家園」是开关：已在菜单里时再点会关掉菜单，所以先找子菜单项，找不到才点导航。
    // 任务入口：先确认是不是已经在秘境面板，不是才走导航
    "进入淫乱秘境": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        // 两个候选项都识别失败时，1s 内决定去展开菜单，别空转 20s
        "timeout": 1000,
        "next": ["确认已进入秘境", "进入家园"],
        // 两个候选都不成立 = 不在秘境、子菜单也收着；这时才去点「家園」
        //
        // 第二候选 `重进失败` 不能省：如果 `打开家园菜单` 因任何原因被跳过
        // （Maa 的候选机制、或以后再加 max_hit），没有兜底就会
        // `invalid node id, handle error` 直接收尾（§3.48）。
        "on_error": ["打开家园菜单", "重进失败"]
    },
    "进入家园": {
        "recognition": "TemplateMatch",
        "template": "home_menu_first.png",
        // 子菜单出现在屏幕左下角
        // 启动校准前也要兼容不同长边：先给左下半屏，校准后再收窄。
        "roi": [0, 600, 400, 1000],
        "threshold": 0.8,
        "action": "Click",
        // 原生 Click 在框内随机取点；129x77 的菜单项收 20px 边，
        // 避免点到旁边的空白（同 `打开家园菜单`）。
        "target_offset": [20, 20, -40, -30],
        "timeout": 3000,
        "post_wait_freezes": 600,
        // 点「淫乱秘境」后可能先弹之前采集到的「恭喜獲得」。
        // 先清弹窗再确认面板：没有弹窗时第一候选识别失败，
        // 直接回落到第二候选 `确认已进入秘境`。
        "next": ["清弹窗后继续", "确认已进入秘境"]
    },
    // 菜单没展开时才走这里：点底部「家園」，等动画结束再回到上面的检查
    "打开家园菜单": {
        "recognition": "TemplateMatch",
        "template": "nav_home.png",
        "roi": [0, 600, 720, 1200],
        "threshold": 0.8,
        "action": "Click",
        // 原生 Click 在**识别框内随机取点**（11-14 离线实测 60 次：
        // x 0..86 / y 5..95，18% 落在图标外）。nav_home.png 的 100x100 框里
        // 图标只占 x14..97 / y18..99，框四边是底栏背景。
        // target_offset 把落点收进图标中心区，实测 60/60 全在图标内。
        "target_offset": [30, 30, -50, -50],
        // 这个 timeout 是**候选扫描窗口**，不是动作超时：Maa 用父节点的
        // timeout 决定 next 候选能重试多久，候选自己的 timeout 不生效
        // （11-14 三组实验，见 §3.44）。不写就是默认 20000，一次没开菜单
        // 就白等 20s。
        "timeout": 4000,
        "post_wait_freezes": 1000,
        // `max_hit` 只在「节点出现在自己的 next 里」时才会计数！
        // 原来 next 只有 `进入家园`，一旦它失败就直接落到调用方的 on_error，
        // max_hit: 6 一次都没用上（11-14 离线验证：next=[B] → 1 次点击；
        // next=[B, A] → max_hit 次点击）。这里把自己加进 next，
        // 「家園」是 toggle，多点一次正好能把误关的菜单重新打开。
        //
        // 11-15 去掉 `max_hit` 与自引用（§3.53）：
        //
        //   - `max_hit` 是**整趟任务共享**的全局配额，不是每轮重置。
        //     原来 3 次在长任务里必然用光（11-15 15:25 那轮重进 4 次就到顶），
        //     之后「家園」再也点不开、任务无声收尾。
        //   - 但**只去掉 max_hit 而保留自引用 = 死循环**（11-15 实测：
        //     `打开家园菜单` 在非主页面帧上连点 20+ 次停不下来）。
        //
        // 重试改由 `开菜单闸门`（ReopenGate，每轮 3 次）负责：
        // 点一次没展开就再过闸门点一次，闸门用光才落 `重进失败`。
        "next": ["进入家园"],
        // 候选耗尽（点了家園但子菜单没出现）→ 过闸门再点一次；
        // 闸门用光 = 家園点不开（断网弹窗 / 停在别的界面）→ `重进失败`。
        "on_error": ["开菜单闸门", "重进失败"]
    },
    // 命中 = 本轮还可以再点一次「家園」展开菜单（每轮 3 次，§3.53）
    "开菜单闸门": {
        "recognition": "Custom",
        "custom_recognition": "ReopenGate",
        "custom_recognition_param": {"max_reopen": 3},
        "action": "DoNothing",
        "timeout": 1000,
        "next": ["计数并重开菜单"]
    },
    "计数并重开菜单": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "CountReopen",
        "timeout": 1000,
        "next": ["打开家园菜单"]
    },
    // ===== 任务二：领取「恭喜獲得」弹窗（独立 entry） =====
    // 与导航链解耦：屏幕上没有弹窗是正常空闲，不应判成任务失败。
    // 有弹窗 -> 点弹窗主体 -> 继续找下一条；找不到 -> on_error 落到收尾节点。
    "关闭获得弹窗": {
        "recognition": "TemplateMatch",
        "template": "obtain_resource.png",
        // 弹窗标题在 720 画布上位于 y≈496..606
        "roi": [0, 300, 720, 700],
        "threshold": 0.9,
        "action": "Click",
        // 必须点在「弹窗面板」之外：面板在 720 画布上覆盖 y≈485..958，
        // 原来 +300 落在 y=851（面板内），点它关不掉弹窗，会空转 139s。
        // 用面板下方的暗色区 y≈1326：标题框中心 y=551，offset +775。
        // 这个点在弹窗面板外、秘境面板内的空白处，单点与连续点击都不会误触 UI。
        // 仍由识别框推导，不是绝对坐标。
        "target_offset": [0, 775, 0, 0],
        "timeout": 3000,
        // 识别到就点，不等默认的 pre_delay=200ms。
        "pre_delay": 0,
        // Maa 默认 rate_limit=1000ms：识别失败后要睡满 1s 才重试。
        // 关掉 live view 后每帧都是真截图（约 0.5s），再等 1s 纯属浪费；
        // 250ms 让重试间隔从 ~1.0s 降到 ~0.7s。
        "rate_limit": 250,
        // 实测单次截图约 600ms，点击 60ms；250ms 足够等弹窗切换
        "post_delay": 250,
        "next": ["关闭获得弹窗"],
        "on_error": ["奖励已清空"]
    },
    // 导航链里的弹窗循环：只负责把进场弹窗点掉，然后继续做落地校验。
    // 独立 entry `关闭获得弹窗` 保持不变；这里多一个 `确认已进入秘境` 候选，
    // 因为 `next` 是候选列表：弹窗清空后自身识别失败，会落到确认节点。
    "清弹窗后继续": {
        "recognition": "TemplateMatch",
        "template": "obtain_resource.png",
        "roi": [0, 300, 720, 700],
        "threshold": 0.9,
        "action": "Click",
        "target_offset": [0, 775, 0, 0],
        "timeout": 3000,
        "pre_delay": 0,
        "rate_limit": 250,
        "post_delay": 250,
        "next": ["清弹窗后继续", "确认已进入秘境"]
    },
    // 收尾节点：保证「没有弹窗」时任务仍然成功结束
    "奖励已清空": {
        "recognition": "DirectHit",
        "action": "DoNothing"
    },
    // 弹窗关完的落地校验：秘境面板上的「管理」按钮
    "确认已进入秘境": {
        "recognition": "TemplateMatch",
        "template": "realm_marker.png",
        "roi": [0, 400, 720, 1100],
        "threshold": 0.9,
        // 点完「淫乱秘境」可能还要等加载，这里放宽到 5s
        "timeout": 5000,
        // 记录「自己秘境」，派遣策略据此每格只派 1 只
        "action": "Custom",
        "custom_action": "SetRealm",
        "custom_action_param": {"realm": "own"}
    },
    // 选格前先读「管理」左侧的 `閒【N】`（空闲）和右侧的 `【M】總`（总数）。
    // 实测：閒【0】@(213,1084,111,35)，【8】總 @(431,1084,84,37)。
    // N>0 才进主循环选格；N=0 或 OCR 读不到 → 收尾，不再点格子。
    "读空闲鸡妖": {
        "recognition": "Custom",
        "custom_recognition": "ChickenStock",
        "roi": [205, 1065, 120, 80],
        "custom_recognition_param": {
            "total_roi": [420, 1065, 120, 80]
        },
        "action": "DoNothing",
        "timeout": 3000,
        // 库存为 0 时本节点识别失败，由调用方的第二候选落到
        // `没有空闲鸡妖`；这里不能再写自己的 on_error，否则
        // `主循环选格` 没格子时也会被误判成没鸡妖。
        // 选格失败时走本节点的第二候选 `主循环无目标` → 主循环探尋。
        "next": ["主循环选格", "主循环无目标"]
    },
    // 0 只空闲鸡妖时正常收尾（不是识别失败，不点任何东西）
    "没有空闲鸡妖": {
        "recognition": "DirectHit",
        // 0 只空闲鸡妖：先清掉挡点击的弹窗，再点底栏「冒险」回主页面、
        // 重进，等待获得弹窗后再继续。
        "action": "Custom",
        "custom_action": "MarkWait",
        "next": ["退到主页面"]
    },
    // 回主页面前清弹窗：只关「恭喜獲得」/「資源詳情」，不拿空处撞秘境面板。
    // 实测 nav_home 在自家秘境面板上也命中 0.997；真正的主页面 tab 是「冒险」。
    "退到主页面": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "BackToHome",
        "timeout": 3000,
        // 弹窗清完后由 `回主界面` 点底栏「冒险」回主页面
        "next": ["回主界面"],
        // 四次清弹窗后仍有弹窗才收尾；正常路径不会走到这里。
        // 不能把 `回主界面` 同时写进 next/on_error（maa-tools 报重复路由）。
        "on_error": ["重进失败"]
    },
    // ===== 任务三：在秘境面板里挑一个资源格并点开「資源詳情」 =====
    // 识别走 agent/cell_reco.py 的 PickCell（Custom）：
    //   1. 先跑鸡妖检测，被抢夺的整列跳过
    //   2. 其余格子逐个匹配 7 个物品模板（阈值 0.88）
    //   3. 按优先级挑第一个命中，返回该格子的框
    // 用自定义识别而不是 7 个 TemplateMatch 节点：原生节点无法跨模板比优先级，
    // 也无法「先按鸡妖 x 区间屏蔽整列再选」。
    "选格并点击": {
        "recognition": "Custom",
        "custom_recognition": "PickCell",
        // 秘境内容区。y 上限 1060 是实测边界：格子最高到 y≈967，
        // 而「管理」按钮上的鸡妖在 y≈1097，必须排除。
        // 底部资源栏在 y>1300，枸杞模板会命中那里（0.888~0.890），一并排除。
        "roi": [0, 250, 720, 810],
        "action": "Click",
        // PickCell 本身很快：离线实测 104~177ms（SIFT 5 只鸡妖 + 6 格匹配）。
        // 真机上每次尝试还要加一次截图（~1.2s），所以 2.5s 大约够 2 次尝试。
        // 不要给太长：全部格子被抢时 PickCell 每次都确定返回 None，
        // 重试只是空转（实测 8s 会让这个负例白跑 9 秒）。
        // 本节点通常接在「确认已进入秘境」之后，面板已经稳定，不需要长超时。
        "timeout": 2500,
        // 点完格子要等「資源詳情」浮窗弹出来
        "post_wait_freezes": 600,
        "next": ["确认资源详情"],
        // 没有可用格子（全被抢 / 全是不需要的物品）是正常情况，不是失败
        "on_error": ["没有目标资源"]
    },
    // 点开格子后的落地校验：浮窗里的「掠奪」按钮
    "确认资源详情": {
        "recognition": "TemplateMatch",
        "template": "btn_dispatch.png",
        // 浮窗固定在 (262,985)，204x54
        "roi": [200, 930, 320, 160],
        // 实测 5 张截图都是 0.958，取 0.94 留余量
        "threshold": 0.94,
        "action": "DoNothing",
        "timeout": 3000
    },
    // ===== 任务五：按秘境归属/物品等级调整派遣只数并点「掠奪」（§3.18）=====
    // 入口是浮窗本身：先确认「掠奪」在（= 浮窗已弹出），再读鸡妖数量。
    // 单独做成一个 entry，不接在 `确认资源详情` 后面：
    // `选格并点击` 是 interface.json 里的调试入口，接了之后单跑它就会真的派兵。
    "派遣并掠奪": {
        "recognition": "TemplateMatch",
        "template": "btn_dispatch.png",
        "roi": [200, 930, 320, 160],
        "threshold": 0.94,
        // 浮窗在 = 新一轮派遣开始，把「+」计数清零（Python 侧计数器，
        // 不用 max_hit：max_hit 是整个任务共享的，长循环里第二次就失效）
        "action": "Custom",
        "custom_action": "DispatchReset",
        "timeout": 3000,
        // 按 PickCell 已读到的物品类型/等级算 target；
        // target > 当前空闲鸡妖数 → 先延迟这个资源，换下一个格子。
        "next": ["派遣策略", "延迟该资源"],
        // 浮窗没弹出来（还停在秘境面板）：别在这里点空气
        "on_error": ["派遣失败"]
    },
    // 按 PickCell 读到的物品等级 `N级` 决定本次 target：
    //   自己秘境 → 1；别人秘境普通资源 → 1/2/3 级映射 1/2/3 只；
    //   别人秘境酒米固定 3；别人秘境且 target > 当前空闲鸡妖数
    //   → 返回失败，交给 `延迟该资源`。不再读「道具數量」。
    "派遣策略": {
        "recognition": "Custom",
        "custom_recognition": "DispatchPolicy",
        "roi": [180, 780, 140, 55],
        "action": "DoNothing",
        "timeout": 2000,
        // `读派遣数量` 仍放第一位：自家秘境 target=1、或浮窗本来就已到
        // target 时，一次 OCR 直接去 `掠奪`，不用白跑一次 `加一只鸡妖`。
        //
        // 没到 target 才落到 `加一只鸡妖`，它现在自己「读一次 n/3 →
        // 连点补足 → 回读校正」，不再需要「点一次 + 回读一次」的往返
        // （11-17：7 次派遣 6~20s，主要耗在 `读派遣数量` 的 OCR 重试上）。
        // 连点后仍不到 target → 落到 `掠奪`，不强求 3/3。
        "next": ["读派遣数量", "加一只鸡妖", "掠奪"]
    },
    // 当前鸡妖不够这个资源：点浮窗外关闭詳情，记住该格，换别的资源。
    "延迟该资源": {
        "recognition": "DirectHit",
        // DirectHit 配 post_wait_freezes 必须给 roi，否则 Maa 跳过等待
        "roi": [0, 0, 720, 1560],
        "action": "Custom",
        "custom_action": "DeferCell",
        "timeout": 1000,
        "post_wait_freezes": 300,
        // 别人秘境鸡妖不足：标记该行后直接退出，下三轮不再进这家；
        // 自家秘境仍继续处理其它格子。
        "next": ["延迟后分支"]
    },
    "延迟后分支": {
        "recognition": "Custom",
        "custom_recognition": "RealmOtherGate",
        "action": "DoNothing",
        "timeout": 1000,
        "next": ["点探尋并下翻"],
        "on_error": ["主循环选格", "主循环无目标"]
    },
    // 读 `雞妖数量 n/3`，并和 `DispatchPolicy` 写入的 target 比较。
    // ROI 只框这一行（x 395..560），不能放宽到含「道具数量」（x 187..298）。
    // 实测四帧：1/3、2/3、3/3、1/3 全部读对（§3.18 / §3.23）。
    // 目标来自 `ChickenStock` 读到的 `閒【N】`，所以库存只有 1/2 只时
    // 不会盲目加 3/3。
    "读派遣数量": {
        "recognition": "Custom",
        "custom_recognition": "DispatchCountReached",
        "roi": [395, 790, 165, 45],
        "action": "DoNothing",
        // 旧值 2000：读不到 3/3 时 Maa 会在这个窗口里反复 OCR 同一帧
        // （11-17 trace：`reached:False` 连打 3 次，每次白烧 ~2.5s）。
        // 现在「没到 target」由 `加一只鸡妖` 自己读一次再补点，这里失败
        // 就是真的没到，不需要长时间重试。
        "timeout": 1200,
        "next": ["掠奪"]
        // 注意：作为 `派遣并掠奪` 的候选被执行时，本节点识别失败不会走自己的
        // on_error，而是回落到调用方（`加一只鸡妖`）的下一个候选 `掠奪`。
        // 所以「还没到 3/3」这条分支写在调用方的 next 里，不写在这里（§3.21）。
    },
